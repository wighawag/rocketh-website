{
	"name": "template-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"devDependencies": {
		"@lucide/svelte": "^1.62.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"github-slugger": "^2.0.0",
		"ipfs-gateway-emulator": "^5.1.0",
		"mode-watcher": "^1.1.0",
		"named-logs": "^0.4.1",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"pwag": "^0.8.0",
		"rehype-raw": "^7.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.5.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"unified": "^11.0.5",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.2.1",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.11",
		"yaml": "^2.9.1"
	},
	"scripts": {
		"prepare": "pnpm generate-pwa-icons-and-tags && svelte-kit sync || echo ''",
		"generate-pwa-icons-and-tags": "pwag static/icon.png src/web-config.json",
		"dev": "vite dev",
		"build": "vite build && node docs-engine/postbuild.js",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"serve": "ipfs-emulator --only -d build -p 8080",
		"test:e2e": "pnpm build && playwright test",
		"test:e2e:headed": "playwright test --headed"
	}
}
